# Flash size floor. This example uses PUBLISHED iroh (main + hickory-resolver
# compiled in, though src/std_dns_resolver.rs swaps hickory out at runtime), so the
# app is ~4.0 MB and needs ≥8 MB flash — a 4 MB S3 (N4) won't fit; 8 MB (N8) does.
# The relay/discovery machinery is compiled too but stays dormant: this build is
# LAN-direct (RelayMode::Disabled) to fit the no-PSRAM 512 KB internal SRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Tokio current_thread runtime runs all async tasks on this single stack. hickory is
# compiled but never runs (the StdDnsResolver override), so the DNS path is the
# platform getaddrinfo, not hickory's ~111 KB async parsing — 48 KB clears the
# LAN-direct QUIC/TLS handshake. If a deeper path ever exceeds this, the stack-
# overflow watchpoint (below) traps it cleanly (distinct from a heap OOM).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
#CONFIG_FREERTOS_HZ=1000

# We use rustls, not mbedtls - disable to save RAM and flash
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
CONFIG_MBEDTLS_TLS_ENABLED=n

# ============================================================================
# PSRAM TOGGLE — switch targets by commenting one block and uncommenting the
# other. The stack/buffer cuts above are sized for no-psram but also work WITH
# psram (just unnecessary headroom), so ONLY this block changes between targets.
# (The relay/pkarr split lives in main.rs — that's the other half of a full
# feature gate, for when PSRAM should also re-enable discovery/relay.)
# Currently active: WITHOUT PSRAM (no-psram branch default).
# ----------------------------------------------------------------------------
# --- WITH PSRAM (M5Stick / WROVER have PSRAM; malloc heap lives in PSRAM) ---
#CONFIG_ESP32_SPIRAM_SUPPORT=y
#CONFIG_SPIRAM=y
#CONFIG_SPIRAM_USE_MALLOC=y
#CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
#CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0
#CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
#
# --- WITHOUT PSRAM (heap + all task stacks must fit in internal SRAM) ---
CONFIG_ESP32_SPIRAM_SUPPORT=n
# ============================================================================

# WiFi buffers — CONFIG_ESP_WIFI_* are the canonical, chip-independent symbols;
# the CONFIG_ESP32_WIFI_* names are esp32-only aliases the S3 silently ignores
# (→ defaults → OOM). Static TX buffers avoid dynamic internal-SRAM allocation.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Halve the dynamic RX pool (default 32 × ~1.6 KB) to relieve heap at connection
# time. Too low risks rx drops → QUIC retransmits; 16 is a safe-ish cut.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Disable AMPDU (block-ack aggregation) — frees the RX reorder buffers; the
# throughput cost is irrelevant for an echo.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# no-psram: shrink lwIP buffers. Relay + pkarr are gone, so there is NO TCP
# traffic anymore (QUIC/SNTP/DNS are all UDP) — TCP windows never allocate, but
# we floor them for hygiene. The real reclaim is the static pools (sockets/PCBs/
# mboxes), which cost upfront heap. UDP mbox kept moderate so QUIC rx bursts
# aren't dropped. (Was 32/8192/8192/32/4096/16/16 for the PSRAM relay-probe era.)
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_MAX_SOCKETS=8

# Use the ROM's nano printf/scanf: smaller formatting code AND a lower stack
# footprint on the format path. Behavior-neutral for this firmware (no wide
# float formatting), so it's a free win on every target.
CONFIG_NEWLIB_NANO_FORMAT=y

# Detect stack overflow via hardware watchpoint (uses 1 of 2 debug watchpoints)
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
